<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="CentroAcopio" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=CentroAcopio;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=5" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
</configuration>
